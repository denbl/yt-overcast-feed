<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.denbl.yt-overcast</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-I</string>
    <string>/Users/denbl/Projects/sandbox/yt-overcast/sync.py</string>
  </array>
  <!-- Every 4 hours. If the Mac was asleep, launchd runs the missed check after wake. -->
  <key>StartInterval</key><integer>14400</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/denbl/Projects/sandbox/yt-overcast/state/sync.log</string>
  <key>StandardErrorPath</key><string>/Users/denbl/Projects/sandbox/yt-overcast/state/sync.log</string>
</dict>
</plist>
